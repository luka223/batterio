<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Batterio.App"
             x:Class="Batterio.App.SettingsPage"
             Title="Batterio Settings">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="28" Spacing="22">
                <Label Text="General" FontSize="22" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="Updates" FontSize="15" />
                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsUpToDate}">
                            <Label Text="&#x2713;" TextColor="#16A34A" FontSize="13" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label Text="Batterio is up to date" FontSize="12" Opacity="0.8" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasUpdateStatusText}">
                            <ActivityIndicator IsRunning="{Binding IsCheckingForUpdates}"
                                               IsVisible="{Binding IsCheckingForUpdates}"
                                               HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                            <Label Text="{Binding UpdateStatusText}" FontSize="12" Opacity="0.65"
                                   LineBreakMode="WordWrap" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <ProgressBar Progress="{Binding UpdateDownloadProgress}"
                                     IsVisible="{Binding IsDownloadingUpdate}"
                                     Margin="0,4,0,0" />
                        <Label Text="{Binding UpdateError}" IsVisible="{Binding HasUpdateError}"
                               TextColor="#DC2626" FontSize="12" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <local:AccentButton Text="Check for updates" Clicked="OnCheckForUpdatesClicked"
                                            IsEnabled="{Binding CanCheckForUpdates}" />
                        <local:AccentButton Text="Download" Clicked="OnDownloadUpdateClicked"
                                            IsVisible="{Binding ShowDownloadButton}"
                                            IsEnabled="{Binding CanDownloadUpdate}" />
                        <local:AccentButton Text="Open releases page" Clicked="OnOpenReleasesPageClicked"
                                            IsVisible="{Binding ShowReleasesPageButton}" />
                        <local:AccentButton Text="{Binding InstallButtonText}" Clicked="OnInstallUpdateClicked"
                                            IsVisible="{Binding ShowInstallButton}"
                                            IsEnabled="{Binding CanInstallUpdate}" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Start automatically when Windows starts."
                               FontSize="15" />
                        <Label Text="Runs Batterio when you sign in to Windows."
                               FontSize="12" Opacity="0.65" />
                    </VerticalStackLayout>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsStartupRegistered, Mode=TwoWay}"
                              IsEnabled="{Binding IsStartupAvailable}"
                              CheckedChanged="OnStartupCheckedChanged"
                              VerticalOptions="Center"
                              SemanticProperties.Description="Start automatically when Windows starts" />
                </Grid>
                <Label Text="Startup registration status is unavailable."
                       IsVisible="{Binding IsStartupUnavailable}" Opacity="0.7" FontSize="12" />
                <Label Text="{Binding StartupError}" IsVisible="{Binding HasStartupError}"
                       TextColor="#DC2626" FontSize="12" />

                <BoxView HeightRequest="1" Opacity="0.2" />
                <Label Text="Devices" FontSize="22" FontAttributes="Bold" />
                <Label Text="Choose which of your devices appear in the tray popup, and which also show their battery level next to the system tray on the taskbar. Devices are listed once they have been connected to this PC."
                       FontSize="13" Opacity="0.7" />
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}"
                       TextColor="#DC2626" FontSize="12" />
                <Label Text="No supported devices have been discovered."
                       IsVisible="{Binding HasNoDevices}" Opacity="0.7" />
                <Grid ColumnDefinitions="*,64,64" ColumnSpacing="20"
                      IsVisible="{Binding HasDevices}">
                    <Label Grid.Column="1" Text="Popup" FontSize="12" Opacity="0.65"
                           HorizontalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="Taskbar" FontSize="12" Opacity="0.65"
                           HorizontalTextAlignment="Center" />
                </Grid>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Devices}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,64,64" Padding="0,8" ColumnSpacing="20">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Text="{Binding ConnectionText}" FontSize="12" Opacity="0.65" />
                                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}"
                                           TextColor="#DC2626" FontSize="11" />
                                </VerticalStackLayout>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          IsEnabled="{Binding IsEnabled}"
                                          CheckedChanged="OnDeviceCheckedChanged"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          SemanticProperties.Description="Show this device in the tray popup" />
                                <CheckBox Grid.Column="2" IsChecked="{Binding IsOnTaskbar, Mode=OneWay}"
                                          IsEnabled="{Binding IsTaskbarEnabled}"
                                          CheckedChanged="OnTaskbarCheckedChanged"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          SemanticProperties.Description="Show this device on the taskbar" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Label x:Name="VersionLabel" Grid.Row="1" Padding="28,8,28,16"
               FontSize="12" Opacity="0.55" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
