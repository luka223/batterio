<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Batterio.App</RootNamespace>
    <AssemblyName>Batterio.Runtime</AssemblyName>
    <UseMaui>true</UseMaui>
    <MauiVersion>10.0.101</MauiVersion>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Batterio</ApplicationTitle>
    <ApplicationIcon>Resources\AppIcon\batterio.ico</ApplicationIcon>
    <ApplicationId>com.batterio.tray</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Batterio.Core\Batterio.Core.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\AppIcon\appicon.svg" Color="#F5F3FF" BaseSize="128,128" />
    <MauiImage Include="Resources\AppIcon\appicon.svg" Link="Resources\Images\battery_placeholder.svg" />
    <Content Include="Resources\AppIcon\batterio.ico" Link="batterio.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>
</Project>
