<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Batterio.Core/Batterio.Core.csproj" />
    <Compile Include="../../src/Batterio.App/Windows/WindowsToast*.cs" Link="Windows/%(Filename)%(Extension)" />
    <Compile Include="../../src/Batterio.App/Windows/WindowsBatteryNotificationService.cs" Link="Windows/WindowsBatteryNotificationService.cs" />
    <Compile Include="../../src/Batterio.App/Windows/IWindowsToastPlatform.cs" Link="Windows/IWindowsToastPlatform.cs" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106" PrivateAssets="all" />
  </ItemGroup>
</Project>
